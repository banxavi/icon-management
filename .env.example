# ICON Team 1 Portal — copy to .env.local (never commit .env.local).
# Real values live ONLY in Vercel / Supabase dashboards.
#
# Local development uses the Supabase dev project only:
#   name:   ICON Management
#   ref:    egylwfpxaxqqlmselygj
#   URL:    https://egylwfpxaxqqlmselygj.supabase.co
#   region: ap-northeast-1
# Set NEXT_PUBLIC_SUPABASE_URL to that URL. Copy the anon and service role
# keys from the Supabase dashboard. Never commit real keys.
# pnpm seed:dev also needs SEED_DEV_PASSWORD in the shell, not in this file.
# Staging ref eidprpfsvkbwramncqen is not the local target.

# Supabase project URL (dev locally: Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe for browser; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import in client components.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL of this deployment (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=
