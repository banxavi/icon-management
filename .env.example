# ICON Team 1 Portal — copy to .env.local (never commit .env.local).
# Prefer `neon env pull` after `neon link` / `neon deploy` (writes Neon vars).
# Generate cookie secret: openssl rand -base64 32

# Neon Postgres (pooled for app traffic)
DATABASE_URL=
# Neon Postgres direct (migrations / seed)
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_BRANCH_ID=

# Neon Managed Better Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
# Optional browser alias for SupabaseAuthAdapter client
NEXT_PUBLIC_NEON_AUTH_BASE_URL=

# Base URL of this deployment (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed only (shell, never commit): SEED_PASSWORD='IconSeed-Test-2026!'
